<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="ContentApp">
  <Id>AF015CA1-1705-46AA-9A13-45681656C411</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>__PROVIDER__</ProviderName>
  <DefaultLocale>zh-CN</DefaultLocale>
  <DisplayName DefaultValue="HTML 嵌入"/>
  <Description DefaultValue="把本地 HTML 嵌入幻灯片，内容保存在 PPT 里，放映时可交互。"/>
  <IconUrl DefaultValue="__BASE__/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="__BASE__/icon-80.png"/>
  <SupportUrl DefaultValue="__BASE__/"/>
  <AppDomains>
    <AppDomain>https://appsforoffice.microsoft.com</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Presentation"/>
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="__BASE__/content.html"/>
    <RequestedWidth>640</RequestedWidth>
    <RequestedHeight>360</RequestedHeight>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <AllowSnapshot>true</AllowSnapshot>
</OfficeApp>
